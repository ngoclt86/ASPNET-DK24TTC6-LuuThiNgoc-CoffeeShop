@{
    Layout = null;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin | CoffeeShop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <div class="admin-wrapper">
        <!-- Sidebar -->
        <nav class="admin-sidebar">
            <div class="sidebar-header">
                <h3 data-i18n="admin.title">CoffeeShop Admin</h3>
                <span class="sidebar-subtitle" data-i18n="admin.subtitle">Quản lý cửa hàng</span>
            </div>
            <ul class="sidebar-menu">
                <li class="@(currentController == "AdminDashboard" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="AdminDashboard" asp-action="Index">
                        <i class="fas fa-th-large"></i> <span data-i18n="admin.dashboard">Tổng quan</span>
                    </a>
                </li>
                <li class="@(currentController == "AdminProduct" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="AdminProduct" asp-action="Index">
                        <i class="fas fa-clipboard-list"></i> <span data-i18n="admin.inventory">Kho hàng</span>
                    </a>
                </li>
                <li class="@(currentController == "AdminCategory" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="AdminCategory" asp-action="Index">
                        <i class="fas fa-layer-group"></i> <span data-i18n="admin.categories">Danh mục</span>
                    </a>
                </li>
                <li class="@(currentController == "AdminOrder" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="AdminOrder" asp-action="Index">
                        <i class="fas fa-shopping-cart"></i> <span data-i18n="admin.orders">Đơn hàng</span>
                    </a>
                </li>
                <li class="@(currentController == "AdminUser" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="AdminUser" asp-action="Index">
                        <i class="fas fa-users"></i> <span data-i18n="admin.users">Người dùng</span>
                    </a>
                </li>
                <li class="@(currentController == "AdminCoupon" ? "active" : "")">
                    <a asp-area="Admin" asp-controller="AdminCoupon" asp-action="Index">
                        <i class="fas fa-ticket-alt"></i> <span data-i18n="admin.coupons">Mã giảm giá</span>
                    </a>
                </li>
                <li class="sidebar-divider"></li>
                <li>
                    <a asp-area="" asp-controller="Home" asp-action="Index">
                        <i class="fas fa-globe"></i> <span data-i18n="admin.view_store">Xem cửa hàng</span>
                    </a>
                </li>
                <li>
                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="sidebar-logout">
                            <i class="fas fa-sign-out-alt"></i> <span data-i18n="admin.logout">Đăng xuất</span>
                        </button>
                    </form>
                </li>
            </ul>
        </nav>

        <!-- Main Content -->
        <div class="admin-main">
            <header class="admin-header">
                <h2>@ViewData["Title"]</h2>
                <div class="admin-header__actions">
                    <button class="lang-toggle" id="langToggle" onclick="CoffeeI18n.toggleLanguage()">
                        <i class="fas fa-globe"></i> EN
                    </button>
                    <button class="admin-header__icon">
                        <i class="fas fa-bell"></i>
                    </button>
                    <div class="admin-user-info">
                        <i class="fas fa-user-circle"></i>
                        <span>@User.Identity?.Name</span>
                    </div>
                </div>
            </header>

            @if (TempData["Success"] != null)
            {
                <div style="padding: 0.75rem 2rem 0;">
                    <div class="alert-brew alert-brew--success">
                        <i class="fas fa-check-circle"></i> @TempData["Success"]
                    </div>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div style="padding: 0.75rem 2rem 0;">
                    <div class="alert-brew alert-brew--error">
                        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                    </div>
                </div>
            }

            <main class="admin-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/i18n.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
