@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.ViewModels.ProductIndexViewModel
@{
    ViewData["Title"] = "Shop";
    var categories = Model.Categories;
    var currentCategory = Model.CurrentCategory;
    var currentSearch = Model.CurrentSearch;
    var currentSort = Model.CurrentSort;
}

<div class="shop-page">
    <!-- Header -->
    <div class="shop-header">
        <div class="container" style="display:flex;justify-content:space-between;align-items:flex-end;">
            <div>
                <h1 class="shop-header__title" data-i18n="shop.title">Bộ sưu tập<br/>Đặc biệt</h1>
                <p class="shop-header__desc" data-i18n="shop.desc">Các loại cà phê chọn lọc và đặc biệt theo mùa. Rang để tôn lên hương vị tự nhiên.</p>
            </div>
            <span class="shop-header__count"><span data-i18n="shop.showing">Hiển thị</span> @Model.TotalItems <span data-i18n="shop.offerings">sản phẩm</span></span>
        </div>
    </div>

    <!-- Layout: Sidebar + Grid -->
    <div class="container">
        <div class="shop-layout">
            <!-- Sidebar Filters -->
            <aside class="shop-filter">
                <h3 class="shop-filter__title" data-i18n="shop.refine">Bộ lọc</h3>

                <div class="shop-filter__group">
                    <h4 class="shop-filter__group-title" data-i18n="shop.category">Danh mục</h4>
                    <a asp-action="Index"
                       asp-route-search="@currentSearch"
                       asp-route-sort="@currentSort"
                       asp-route-page="1"
                       class="shop-filter__option @(!currentCategory.HasValue ? "is-active" : "")">
                        <span data-i18n="shop.all">Tất cả</span>
                    </a>
                    @if (categories.Any())
                    {
                        @foreach (var cat in categories)
                        {
                            <a asp-action="Index"
                               asp-route-categoryId="@cat.Id"
                               asp-route-search="@currentSearch"
                               asp-route-sort="@currentSort"
                               asp-route-page="1"
                               class="shop-filter__option @(currentCategory == cat.Id ? "is-active" : "")">
                                @cat.Name
                            </a>
                        }
                    }
                </div>
            </aside>

            <!-- Products Grid -->
            <div>
                <form asp-action="Index" method="get" class="shop-toolbar">
                    @if (currentCategory.HasValue)
                    {
                        <input type="hidden" name="categoryId" value="@currentCategory" />
                    }
                    <div class="shop-search">
                        <i class="fas fa-search"></i>
                        <input type="text"
                               name="search"
                               value="@currentSearch"
                               placeholder="Tìm kiếm sản phẩm..."
                               data-i18n-ph="common.search_products" />
                    </div>
                    <div class="shop-sort">
                        <label for="sort" class="shop-sort__label">Sắp xếp</label>
                        <select id="sort" name="sort" class="shop-sort__select">
                            <option value="" selected="@(string.IsNullOrWhiteSpace(currentSort) ? "selected" : null)">Mới nhất</option>
                            <option value="name_asc" selected="@(currentSort == "name_asc" ? "selected" : null)">Tên A-Z</option>
                            <option value="name_desc" selected="@(currentSort == "name_desc" ? "selected" : null)">Tên Z-A</option>
                            <option value="price_asc" selected="@(currentSort == "price_asc" ? "selected" : null)">Giá thấp đến cao</option>
                            <option value="price_desc" selected="@(currentSort == "price_desc" ? "selected" : null)">Giá cao đến thấp</option>
                        </select>
                    </div>
                    <input type="hidden" name="page" value="1" />
                    <button type="submit" class="btn-brew btn-brew--primary btn-brew--sm">Áp dụng</button>
                    <a asp-action="Index" class="btn-brew btn-brew--secondary btn-brew--sm">Đặt lại</a>
                </form>

                @if (!Model.Items.Any())
                {
                    <div class="empty-state">
                        <div class="empty-state__icon"><i class="fas fa-search"></i></div>
                        <p class="empty-state__text" data-i18n="shop.no_products">Không tìm thấy sản phẩm.</p>
                        <a asp-action="Index" class="btn-brew btn-brew--primary" data-i18n="shop.view_all">Xem tất cả</a>
                    </div>
                }
                else
                {
                    <div class="products-grid">
                        @foreach (var product in Model.Items)
                        {
                            <div class="product-card">
                                <a asp-action="Details" asp-route-id="@product.Id" style="text-decoration:none;">
                                    <div class="product-card__image">
                                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            <img src="@product.ImageUrl" alt="@product.Name" />
                                        }
                                        else
                                        {
                                            <div class="product-card__placeholder"><i class="fas fa-coffee"></i></div>
                                        }
                                        <span class="product-card__badge product-card__badge--medium">@(product.Category?.Name ?? "Coffee")</span>
                                    </div>
                                </a>
                                <div class="product-card__body">
                                    <span class="product-card__origin">@(product.Category?.Name?.ToUpper() ?? "COFFEE")</span>
                                    <h5 class="product-card__name">
                                        <a asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                                    </h5>
                                    <p class="product-card__desc">@(product.Description?.Length > 60 ? product.Description.Substring(0, 60) + "..." : product.Description)</p>
                                    <div class="product-card__footer">
                                        <span class="product-card__price">@product.Price.ToString("N0")đ</span>
                                        <form asp-controller="Cart" asp-action="Add" method="post">
                                            <input type="hidden" name="productId" value="@product.Id" />
                                            <button type="submit" class="btn-brew btn-brew--primary btn-brew--sm" data-i18n="shop.add_to_cart">Thêm vào giỏ</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    @if (Model.TotalPages > 1)
                    {
                        <nav class="shop-pagination" aria-label="Phân trang sản phẩm">
                            @if (Model.CurrentPage > 1)
                            {
                                <a asp-action="Index"
                                   asp-route-categoryId="@currentCategory"
                                   asp-route-search="@currentSearch"
                                   asp-route-sort="@currentSort"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   class="shop-pagination__link">Trước</a>
                            }
                            else
                            {
                                <span class="shop-pagination__link is-disabled">Trước</span>
                            }

                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                if (i == Model.CurrentPage)
                                {
                                    <span class="shop-pagination__link is-active">@i</span>
                                }
                                else
                                {
                                    <a asp-action="Index"
                                       asp-route-categoryId="@currentCategory"
                                       asp-route-search="@currentSearch"
                                       asp-route-sort="@currentSort"
                                       asp-route-page="@i"
                                       class="shop-pagination__link">@i</a>
                                }
                            }

                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <a asp-action="Index"
                                   asp-route-categoryId="@currentCategory"
                                   asp-route-search="@currentSearch"
                                   asp-route-sort="@currentSort"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   class="shop-pagination__link">Sau</a>
                            }
                            else
                            {
                                <span class="shop-pagination__link is-disabled">Sau</span>
                            }
                        </nav>
                    }
                }
            </div>
        </div>
    </div>
</div>
