@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<div class="profile-page">
    <div class="container">
        <a asp-action="Profile" class="profile-back-link">
            <i class="fas fa-arrow-left"></i> <span data-i18n="profile.back">Quay lại hồ sơ</span>
        </a>

        <div class="auth-card" style="max-width:500px;margin:0 auto;">
            <div class="auth-card__header">
                <h1 class="auth-card__brand" data-i18n="profile.change_pw_title">Đổi mật khẩu</h1>
                <p class="auth-card__subtitle" data-i18n="profile.change_pw_subtitle">Nhập mật khẩu hiện tại và mật khẩu mới.</p>
            </div>

            <form asp-action="ChangePassword" method="post">
                <div asp-validation-summary="ModelOnly" style="color:var(--color-error);font-size:0.85rem;margin-bottom:1rem;"></div>

                <div class="auth-field">
                    <label class="auth-field__label"><span data-i18n="profile.current_pw">Mật khẩu hiện tại</span></label>
                    <div class="auth-field__wrapper">
                        <i class="fas fa-lock auth-field__icon"></i>
                        <input asp-for="CurrentPassword" class="auth-field__input" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="CurrentPassword" style="color:var(--color-error);font-size:0.78rem;"></span>
                </div>

                <div class="auth-field">
                    <label class="auth-field__label"><span data-i18n="profile.new_pw">Mật khẩu mới</span></label>
                    <div class="auth-field__wrapper">
                        <i class="fas fa-key auth-field__icon"></i>
                        <input asp-for="NewPassword" class="auth-field__input" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="NewPassword" style="color:var(--color-error);font-size:0.78rem;"></span>
                </div>

                <div class="auth-field">
                    <label class="auth-field__label"><span data-i18n="profile.confirm_new_pw">Xác nhận mật khẩu mới</span></label>
                    <div class="auth-field__wrapper">
                        <i class="fas fa-shield-alt auth-field__icon"></i>
                        <input asp-for="ConfirmNewPassword" class="auth-field__input" placeholder="••••••••" />
                    </div>
                    <span asp-validation-for="ConfirmNewPassword" style="color:var(--color-error);font-size:0.78rem;"></span>
                </div>

                <button type="submit" class="btn-brew btn-brew--primary btn-brew--full btn-brew--lg" data-i18n="profile.change_pw_btn">
                    <i class="fas fa-check"></i> Đổi mật khẩu
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
