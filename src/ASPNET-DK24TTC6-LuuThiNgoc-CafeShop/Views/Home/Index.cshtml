@model List<ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Product>
@{
    ViewData["Title"] = "CoffeeShop";
    var categories = ViewBag.Categories as List<ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Category>;
}

<!-- Hero Section -->
<section class="hero">
    <div class="container">
        <div class="hero__container">
            <div class="hero__content">
                <span class="hero__label" data-i18n="home.hero_label">Cà phê thượng hạng</span>
                <h1 class="hero__title" data-i18n="home.hero_title">Đánh thức<br/>Giác quan.</h1>
                <p class="hero__text" data-i18n="home.hero_text">Trải nghiệm nghệ thuật pha chế hoàn hảo. Nguồn gốc đạo đức, rang cẩn thận, giao hàng tận tâm.</p>
                <a asp-controller="Product" asp-action="Index" class="btn-brew btn-brew--primary" data-i18n="home.shop_now">Mua ngay</a>
            </div>
            <div class="hero__image">
                <div class="hero__image-frame"></div>
                <img
                    class="hero__image-main"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuCNQ03_0NlNPxbD2ybb1nVrK9t-gfPlIg00kY5dTKXgtboZ7fjVqDcDXO0nJgOYoDvssK9BSRVMBKYIdxOXK1mOzrbV_BEC1tZLi2idFjNDSDUQEIKjnaKUOHLDTMB6H0a-XZgY8E3VL7TNVs0K7u5mvShyUcOGLv2UZbmU4EsxQsuyOb_9OYKPTUW-s2REWMAJ4PnG1ntwCkpGz2x-M9TKL_VSWA_MtIl9idxy-Ff0H9SJQUvZ1M6GUbBG3vRmcUPEc8UH5oa4lZ4"
                    alt="Espresso Pour" />
                <img
                    class="hero__image-secondary"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuDFfiCfevJAGNjo9pAZPYT0UL-AXi4ocy-Cid6ibn6V8NYBIdMhnehRbj2dP_gQaUsG49ygyYGs90TNJhC6u_FNo0W70UxAop4znDV58QpOwmEd0cc9dHAtt0jsa_1aLubAlduaNtJxdgPxIGmwthqvX1XIQNcPrhTR0dVYJSTRAQkBRCywFHWklUFx0UpvcGo753_ZRjmTvUicznMmbxT88QyLTvMkIQaySTt4Cq-A2Ro1KeiOr74wH0nhBUSW6S5F1-_oZOP8j94"
                    alt="Coffee Beans" />
            </div>
        </div>
    </div>
</section>

<!-- Category Pills -->
<section class="container">
    <div class="category-pills">
        <span class="category-pills__label" data-i18n="home.explore">Khám phá:</span>
        <a asp-controller="Product" asp-action="Index" class="category-pill active" data-i18n="home.all_offerings">Tất cả sản phẩm</a>
        @if (categories != null)
        {
            @foreach (var cat in categories)
            {
                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@cat.Id" class="category-pill">@cat.Name</a>
            }
        }
    </div>
</section>

<!-- Featured Products -->
<section class="container section-pad">
    <div class="section-header">
        <div>
            <h2 class="section-header__title" data-i18n="home.featured_title">Sản phẩm nổi bật</h2>
            <p class="section-header__subtitle" data-i18n="home.featured_subtitle">Được chọn lọc dành cho bạn.</p>
        </div>
        <a asp-controller="Product" asp-action="Index" class="section-header__link" data-i18n="home.view_all">Xem tất cả →</a>
    </div>

    @if (Model.Any())
    {
        <div class="products-grid" style="grid-template-columns: repeat(3, 1fr);">
            @foreach (var product in Model.Take(6))
            {
                <div class="product-card">
                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">
                        <div class="product-card__image">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.Name" />
                            }
                            else
                            {
                                <div class="product-card__placeholder"><i class="fas fa-coffee"></i></div>
                            }
                            <span class="product-card__badge product-card__badge--medium">@(product.Category?.Name ?? "Coffee")</span>
                        </div>
                    </a>
                    <div class="product-card__body">
                        <h5 class="product-card__name">
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                        </h5>
                        <p class="product-card__desc">@(product.Description?.Length > 60 ? product.Description.Substring(0, 60) + "..." : product.Description)</p>
                        <div class="product-card__footer">
                            <span class="product-card__price">@product.Price.ToString("N0")đ</span>
                            <form asp-controller="Cart" asp-action="Add" method="post">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="product-card__add-btn" title="Add to cart"><i class="fas fa-plus"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state__icon"><i class="fas fa-coffee"></i></div>
            <p class="empty-state__text" data-i18n="home.no_products">Chưa có sản phẩm nào.</p>
        </div>
    }
</section>

<!-- Seasonal Banner -->
<section class="container">
    <div class="seasonal-banner">
        <div class="seasonal-banner__content">
            <span class="seasonal-banner__label" data-i18n="home.seasonal_label">Sản phẩm theo mùa</span>
            <h3 class="seasonal-banner__title" data-i18n="home.seasonal_title">Bộ sưu tập mùa đông.</h3>
            <p class="seasonal-banner__text" data-i18n="home.seasonal_text">Hỗn hợp ấm áp được tạo ra cho những buổi sáng lạnh giá. Hương vị mận gia vị, hồ đào nướng và ca cao đen. Số lượng có hạn.</p>
            <a asp-controller="Product" asp-action="Index" class="btn-brew btn-brew--secondary" style="color:#fff;border-color:#fff;width:fit-content;" data-i18n="home.seasonal_btn">Khám phá hương vị</a>
        </div>
        <div class="seasonal-banner__image">
            @if (Model.Count > 1 && !string.IsNullOrEmpty(Model[1].ImageUrl))
            {
                <img src="@Model[1].ImageUrl" alt="Seasonal Release" />
            }
            else
            {
                <div style="width:100%;height:100%;min-height:250px;background:#2a1f3d;display:flex;align-items:center;justify-content:center;">
                    <i class="fas fa-snowflake" style="font-size:3rem;color:rgba(255,255,255,0.3);"></i>
                </div>
            }
        </div>
    </div>
</section>