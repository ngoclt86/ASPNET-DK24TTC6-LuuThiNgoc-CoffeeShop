@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__header">
            <h1 class="auth-card__brand">CoffeeShop</h1>
            <p class="auth-card__subtitle">Nhập mật khẩu mới của bạn.</p>
        </div>

        <form asp-action="ResetPassword" method="post">
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" style="color:var(--color-error);font-size:0.85rem;margin-bottom:1rem;"></div>

            <div class="auth-field">
                <label class="auth-field__label">Mật khẩu mới</label>
                <div class="auth-field__wrapper">
                    <i class="fas fa-lock auth-field__icon"></i>
                    <input asp-for="Password" class="auth-field__input" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" style="color:var(--color-error);font-size:0.78rem;"></span>
            </div>

            <div class="auth-field">
                <label class="auth-field__label">Xác nhận mật khẩu</label>
                <div class="auth-field__wrapper">
                    <i class="fas fa-shield-alt auth-field__icon"></i>
                    <input asp-for="ConfirmPassword" class="auth-field__input" placeholder="••••••••" />
                </div>
                <span asp-validation-for="ConfirmPassword" style="color:var(--color-error);font-size:0.78rem;"></span>
            </div>

            <button type="submit" class="btn-brew btn-brew--primary btn-brew--full btn-brew--lg">Cập nhật mật khẩu</button>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
