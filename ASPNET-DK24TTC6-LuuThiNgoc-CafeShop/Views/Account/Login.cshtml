@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__header">
            <h1 class="auth-card__brand">CoffeeShop</h1>
            <p class="auth-card__subtitle" data-i18n="auth.login_subtitle">Đăng nhập để tiếp tục.</p>
        </div>

        <form asp-action="Login" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            <div asp-validation-summary="ModelOnly" style="color:var(--color-error);font-size:0.85rem;margin-bottom:1rem;"></div>

            <div class="auth-field">
                <label class="auth-field__label">
                    <span data-i18n="auth.email_label">Địa chỉ Email</span>
                </label>
                <div class="auth-field__wrapper">
                    <i class="fas fa-envelope auth-field__icon"></i>
                    <input asp-for="Email" class="auth-field__input" placeholder="email@cuaban.com" data-i18n-ph="ph.email" />
                </div>
                <span asp-validation-for="Email" style="color:var(--color-error);font-size:0.78rem;"></span>
            </div>

            <div class="auth-field">
                <label class="auth-field__label">
                    <span data-i18n="auth.password_label">Mật khẩu</span>
                    <a asp-action="ForgotPassword" class="auth-field__link" data-i18n="auth.forgot">Quên mật khẩu?</a>
                </label>
                <div class="auth-field__wrapper">
                    <i class="fas fa-lock auth-field__icon"></i>
                    <input asp-for="Password" class="auth-field__input" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" style="color:var(--color-error);font-size:0.78rem;"></span>
            </div>

            <button type="submit" class="btn-brew btn-brew--primary btn-brew--full btn-brew--lg" style="margin-top:0.5rem;" data-i18n="auth.login_btn">Đăng nhập</button>
        </form>

        <p class="auth-card__footer">
            <span data-i18n="auth.no_account">Chưa có tài khoản?</span> <a asp-action="Register" data-i18n="auth.register_link">Đăng ký</a>
        </p>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
