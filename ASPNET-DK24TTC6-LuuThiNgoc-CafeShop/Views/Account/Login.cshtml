@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__header">
            <h1 class="auth-card__brand">The Sensorial Brew</h1>
            <p class="auth-card__subtitle">Sign in to continue your ritual.</p>
        </div>

        <form asp-action="Login" method="post">
            <div asp-validation-summary="ModelOnly" style="color:var(--color-error);font-size:0.85rem;margin-bottom:1rem;"></div>

            <div class="auth-field">
                <label class="auth-field__label">
                    <span>Email Address</span>
                </label>
                <div class="auth-field__wrapper">
                    <i class="fas fa-envelope auth-field__icon"></i>
                    <input asp-for="Email" class="auth-field__input" placeholder="your@email.com" />
                </div>
                <span asp-validation-for="Email" style="color:var(--color-error);font-size:0.78rem;"></span>
            </div>

            <div class="auth-field">
                <label class="auth-field__label">
                    <span>Password</span>
                    <a href="#" class="auth-field__link">Forgot Password?</a>
                </label>
                <div class="auth-field__wrapper">
                    <i class="fas fa-lock auth-field__icon"></i>
                    <input asp-for="Password" class="auth-field__input" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" style="color:var(--color-error);font-size:0.78rem;"></span>
            </div>

            <button type="submit" class="btn-brew btn-brew--primary btn-brew--full btn-brew--lg" style="margin-top:0.5rem;">Login</button>
        </form>

        <p class="auth-card__footer">
            Don't have an account? <a asp-action="Register">Register</a>
        </p>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
