@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__header">
            <h1 class="auth-card__brand">CoffeeShop</h1>
            <p class="auth-card__subtitle">Nhập email để nhận liên kết đặt lại mật khẩu.</p>
        </div>

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" style="color:var(--color-error);font-size:0.85rem;margin-bottom:1rem;"></div>
            <div class="auth-field">
                <label class="auth-field__label">Email</label>
                <div class="auth-field__wrapper">
                    <i class="fas fa-envelope auth-field__icon"></i>
                    <input asp-for="Email" class="auth-field__input" placeholder="email@cuaban.com" />
                </div>
                <span asp-validation-for="Email" style="color:var(--color-error);font-size:0.78rem;"></span>
            </div>

            <button type="submit" class="btn-brew btn-brew--primary btn-brew--full btn-brew--lg">Gửi liên kết đặt lại</button>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
