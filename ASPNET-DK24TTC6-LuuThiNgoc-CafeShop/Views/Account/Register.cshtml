@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Sign Up";
    Layout = "_Layout";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card__header">
            <h1 class="auth-card__brand">Sensorial Brew</h1>
            <p class="auth-card__subtitle">Curated Rituals. Begin yours today.</p>
        </div>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="ModelOnly" style="color:var(--color-error);font-size:0.85rem;margin-bottom:1rem;"></div>

            <div class="auth-field">
                <label class="auth-field__label"><span>Full Name</span></label>
                <div class="auth-field__wrapper">
                    <i class="fas fa-user auth-field__icon"></i>
                    <input asp-for="FullName" class="auth-field__input" placeholder="Jane Doe" />
                </div>
                <span asp-validation-for="FullName" style="color:var(--color-error);font-size:0.78rem;"></span>
            </div>

            <div class="auth-field">
                <label class="auth-field__label"><span>Email Address</span></label>
                <div class="auth-field__wrapper">
                    <i class="fas fa-envelope auth-field__icon"></i>
                    <input asp-for="Email" class="auth-field__input" placeholder="jane@example.com" />
                </div>
                <span asp-validation-for="Email" style="color:var(--color-error);font-size:0.78rem;"></span>
            </div>

            <div class="auth-field">
                <label class="auth-field__label"><span>Password</span></label>
                <div class="auth-field__wrapper">
                    <i class="fas fa-lock auth-field__icon"></i>
                    <input asp-for="Password" class="auth-field__input" placeholder="••••••••" />
                </div>
                <span asp-validation-for="Password" style="color:var(--color-error);font-size:0.78rem;"></span>
            </div>

            <div class="auth-field">
                <label class="auth-field__label"><span>Confirm Password</span></label>
                <div class="auth-field__wrapper">
                    <i class="fas fa-shield-alt auth-field__icon"></i>
                    <input asp-for="ConfirmPassword" class="auth-field__input" placeholder="••••••••" />
                </div>
                <span asp-validation-for="ConfirmPassword" style="color:var(--color-error);font-size:0.78rem;"></span>
            </div>

            <button type="submit" class="btn-brew btn-brew--primary btn-brew--full btn-brew--lg">Sign Up <i class="fas fa-arrow-right"></i></button>
        </form>

        <p class="auth-card__footer">
            Already have an account? <a asp-action="Login">Log in</a>
        </p>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
