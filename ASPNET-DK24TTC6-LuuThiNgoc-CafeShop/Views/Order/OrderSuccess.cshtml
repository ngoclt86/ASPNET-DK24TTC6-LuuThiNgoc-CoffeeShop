@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Order
@{ ViewData["Title"] = "Order Confirmed"; }

<div class="order-success">
    <div class="container">
        <div class="order-success__icon">
            <i class="fas fa-check"></i>
        </div>
        <h1 class="order-success__title">Your Ritual Awaits.</h1>
        <p class="order-success__text">Thank you for your order! Your beans are being carefully prepared for their journey to you.</p>

        <div class="order-success__card">
            <span class="order-success__order-label">Order Number</span>
            <p class="order-success__order-id">#@Model.Id</p>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">
                <div>
                    <span style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--color-text-secondary);">Estimated Delivery</span>
                    <p style="font-weight:600;margin-top:0.25rem;">@Model.OrderDate.AddDays(3).ToString("dd/MM/yyyy")</p>
                </div>
                <div>
                    <span style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:var(--color-text-secondary);">Payment Method</span>
                    <p style="font-weight:600;margin-top:0.25rem;">Cash on Delivery</p>
                </div>
            </div>

            <div style="border-top:1px solid var(--color-border);padding-top:1rem;">
                <div style="display:flex;justify-content:space-between;font-weight:700;font-size:1.1rem;">
                    <span>Total</span>
                    <span>@Model.TotalAmount.ToString("N0")đ</span>
                </div>
            </div>
        </div>

        <div class="order-success__actions">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn-brew btn-brew--primary btn-brew--lg">
                <i class="fas fa-receipt"></i> View Order
            </a>
            <a asp-controller="Product" asp-action="Index" class="btn-brew btn-brew--outline btn-brew--lg">
                Continue Browsing
            </a>
        </div>
    </div>
</div>
