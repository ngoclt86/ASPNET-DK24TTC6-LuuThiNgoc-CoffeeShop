@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Order
@{ ViewData["Title"] = "Đặt hàng thành công"; }

<div class="container py-5">
    <div class="text-center">
        <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
        <h2>Đặt hàng thành công!</h2>
        <p class="text-muted">Mã đơn hàng: <strong>#@Model.Id</strong></p>
        <p class="text-muted">Tổng tiền: <strong class="text-primary">@Model.TotalAmount.ToString("N0")đ</strong></p>
        <p class="text-muted">Phương thức: Thanh toán khi nhận hàng (COD)</p>
        <div class="mt-4">
            <a asp-action="History" class="btn btn-primary-custom me-2"><i class="fas fa-list"></i> Xem đơn hàng</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Tiếp tục mua sắm</a>
        </div>
    </div>
</div>
