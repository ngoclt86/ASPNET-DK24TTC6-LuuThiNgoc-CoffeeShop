@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Order
@using ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Enums
@{ ViewData["Title"] = $"Đơn hàng #{Model.Id}"; }

<div class="container py-4">
    <h2 class="section-title">Đơn hàng #@Model.Id</h2>
    <div class="row g-4">
        <div class="col-md-8">
            <div class="card p-4">
                <h5 class="mb-3">Sản phẩm đã đặt</h5>
                <table class="table">
                    <thead><tr><th>Sản phẩm</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr></thead>
                    <tbody>
                        @foreach (var item in Model.OrderDetails)
                        {
                            <tr>
                                <td>@item.Product?.Name</td>
                                <td>@item.UnitPrice.ToString("N0")đ</td>
                                <td>@item.Quantity</td>
                                <td>@((item.UnitPrice * item.Quantity).ToString("N0"))đ</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        @if (Model.DiscountAmount > 0)
                        {
                            <tr><td colspan="3" class="text-end">Giảm giá:</td><td class="text-danger">-@Model.DiscountAmount.ToString("N0")đ</td></tr>
                        }
                        <tr><td colspan="3" class="text-end"><strong>Tổng:</strong></td><td><strong class="text-primary">@Model.TotalAmount.ToString("N0")đ</strong></td></tr>
                    </tfoot>
                </table>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-4">
                <h5 class="mb-3">Thông tin</h5>
                <p><strong>Trạng thái:</strong>
                    @switch (Model.Status)
                    {
                        case OrderStatus.Pending: <span class="badge bg-warning text-dark">Chờ xử lý</span> break;
                        case OrderStatus.Processing: <span class="badge bg-info">Đang xử lý</span> break;
                        case OrderStatus.Completed: <span class="badge bg-success">Hoàn thành</span> break;
                        case OrderStatus.Cancelled: <span class="badge bg-danger">Đã hủy</span> break;
                    }
                </p>
                <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                <p><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
                <p><strong>SĐT:</strong> @Model.PhoneNumber</p>
                @if (!string.IsNullOrEmpty(Model.Notes)) { <p><strong>Ghi chú:</strong> @Model.Notes</p> }
                @if (!string.IsNullOrEmpty(Model.CouponCode)) { <p><strong>Mã giảm giá:</strong> @Model.CouponCode</p> }
            </div>
            <a asp-action="History" class="btn btn-outline-secondary mt-3 w-100"><i class="fas fa-arrow-left"></i> Quay lại</a>
        </div>
    </div>
</div>
