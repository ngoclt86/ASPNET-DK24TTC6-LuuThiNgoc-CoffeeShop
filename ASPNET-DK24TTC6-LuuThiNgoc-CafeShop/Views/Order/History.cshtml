@model List<ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Order>
@using ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Enums
@{ ViewData["Title"] = "Lịch sử đơn hàng"; }

<div class="container py-4">
    <h2 class="section-title">Lịch sử đơn hàng</h2>
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
            <p class="text-muted">Bạn chưa có đơn hàng nào.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary-custom">Bắt đầu mua sắm</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Mã ĐH</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td><strong>#@order.Id</strong></td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><strong>@order.TotalAmount.ToString("N0")đ</strong></td>
                            <td>
                                @switch (order.Status)
                                {
                                    case OrderStatus.Pending: <span class="badge bg-warning text-dark">Chờ xử lý</span> break;
                                    case OrderStatus.Processing: <span class="badge bg-info">Đang xử lý</span> break;
                                    case OrderStatus.Completed: <span class="badge bg-success">Hoàn thành</span> break;
                                    case OrderStatus.Cancelled: <span class="badge bg-danger">Đã hủy</span> break;
                                }
                            </td>
                            <td><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
