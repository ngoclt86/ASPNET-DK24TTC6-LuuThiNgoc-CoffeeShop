@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.ViewModels.OrderHistoryViewModel
@using ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Enums
@{ ViewData["Title"] = "Order History"; }

<div class="order-history">
    <div class="container">
        <h1 class="order-history__title" data-i18n="history.title">Lịch sử<br/>Đơn hàng.</h1>
        <p class="order-history__subtitle" data-i18n="history.subtitle">Theo dõi mọi đơn hàng từ đặt đến giao.</p>

        @if (!Model.Orders.Any())
        {
            <div class="empty-state">
                <div class="empty-state__icon"><i class="fas fa-box-open"></i></div>
                <p class="empty-state__text" data-i18n="history.empty">Bạn chưa có đơn hàng nào.</p>
                <a asp-controller="Product" asp-action="Index" class="btn-brew btn-brew--primary" data-i18n="history.start">Bắt đầu mua sắm</a>
            </div>
        }
        else
        {
            <p class="order-history__count">
                <span data-i18n="shop.showing">Hiển thị</span> @Model.Orders.Count / @Model.TotalOrders <span data-i18n="shop.offerings">đơn hàng</span>
            </p>

            @foreach (var order in Model.Orders)
            {
                var itemCount = order.OrderDetails?.Count ?? 0;
                <div class="order-history-card">
                    <div class="order-history-card__left">
                        <p class="order-history-card__id">#@order.Id</p>
                        <p class="order-history-card__date"><i class="fas fa-calendar-alt"></i> @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                        <p class="order-history-card__meta"><i class="fas fa-box"></i> @itemCount <span data-i18n="history.items">sản phẩm</span></p>
                        @if (order.PaymentMethod == PaymentMethod.VnPay)
                        {
                            <p class="order-history-card__meta"><i class="fas fa-credit-card"></i> VNPAY</p>
                        }
                        else
                        {
                            <p class="order-history-card__meta"><i class="fas fa-money-bill-wave"></i> COD</p>
                        }
                    </div>
                    <div class="order-history-card__center">
                        @switch (order.Status)
                        {
                            case OrderStatus.Pending:
                                <span class="status-badge status-badge--pending"><i class="fas fa-clock"></i> <span data-i18n="status.pending">Chờ xử lý</span></span>
                                break;
                            case OrderStatus.Processing:
                                <span class="status-badge status-badge--processing"><i class="fas fa-cog"></i> <span data-i18n="status.processing">Đang xử lý</span></span>
                                break;
                            case OrderStatus.Completed:
                                <span class="status-badge status-badge--completed"><i class="fas fa-check"></i> <span data-i18n="status.completed">Hoàn thành</span></span>
                                break;
                            case OrderStatus.Cancelled:
                                <span class="status-badge status-badge--cancelled"><i class="fas fa-times"></i> <span data-i18n="status.cancelled">Đã hủy</span></span>
                                break;
                        }
                        @if (!string.IsNullOrEmpty(order.ShippingAddress))
                        {
                            <p class="order-history-card__address"><i class="fas fa-map-marker-alt"></i> @(order.ShippingAddress.Length > 40 ? order.ShippingAddress.Substring(0, 40) + "..." : order.ShippingAddress)</p>
                        }
                    </div>
                    <div class="order-history-card__right">
                        @if (order.DiscountAmount > 0)
                        {
                            <p class="order-history-card__discount"><i class="fas fa-tag"></i> -@order.DiscountAmount.ToString("N0")đ</p>
                        }
                        <p class="order-history-card__price">@order.TotalAmount.ToString("N0")đ</p>
                        <div class="order-history-card__actions">
                            <a asp-action="Details" asp-route-id="@order.Id" class="btn-brew btn-brew--primary btn-brew--sm" data-i18n="history.view">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            }

            @if (Model.TotalPages > 1)
            {
                <nav class="shop-pagination" aria-label="Phân trang đơn hàng">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-action="History" asp-route-page="@(Model.CurrentPage - 1)" class="shop-pagination__link" data-i18n="history.prev">Trước</a>
                    }
                    else
                    {
                        <span class="shop-pagination__link is-disabled" data-i18n="history.prev">Trước</span>
                    }

                    @for (var i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            <span class="shop-pagination__link is-active">@i</span>
                        }
                        else
                        {
                            <a asp-action="History" asp-route-page="@i" class="shop-pagination__link">@i</a>
                        }
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a asp-action="History" asp-route-page="@(Model.CurrentPage + 1)" class="shop-pagination__link" data-i18n="history.next">Sau</a>
                    }
                    else
                    {
                        <span class="shop-pagination__link is-disabled" data-i18n="history.next">Sau</span>
                    }
                </nav>
            }
        }
    </div>
</div>
