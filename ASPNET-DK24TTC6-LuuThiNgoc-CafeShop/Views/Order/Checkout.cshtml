@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.ViewModels.CheckoutViewModel
@{ ViewData["Title"] = "Thanh toán"; }

<div class="container py-4">
    <h2 class="section-title">Thanh toán</h2>
    <form asp-action="Checkout" method="post">
        <div class="row g-4">
            <div class="col-md-7">
                <div class="card p-4">
                    <h5 class="mb-3">Thông tin giao hàng</h5>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="ShippingAddress" class="form-label"></label>
                        <input asp-for="ShippingAddress" class="form-control" />
                        <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="CouponCode" class="form-label"></label>
                        <input asp-for="CouponCode" class="form-control" placeholder="Nhập mã giảm giá (nếu có)" />
                        <span asp-validation-for="CouponCode" class="text-danger"></span>
                    </div>
                    <div class="mt-3">
                        <p class="text-muted"><i class="fas fa-truck"></i> Phương thức: <strong>Thanh toán khi nhận hàng (COD)</strong></p>
                    </div>
                </div>
            </div>
            <div class="col-md-5">
                <div class="card p-4">
                    <h5 class="mb-3">Đơn hàng của bạn</h5>
                    @foreach (var item in Model.CartItems)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <span>@item.ProductName x@item.Quantity</span>
                            <span>@item.Total.ToString("N0")đ</span>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tạm tính:</span>
                        <span>@Model.SubTotal.ToString("N0")đ</span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Tổng cộng:</span>
                        <span class="text-primary">@Model.Total.ToString("N0")đ</span>
                    </div>
                    <button type="submit" class="btn btn-primary-custom w-100 mt-3 btn-lg">
                        <i class="fas fa-check"></i> Đặt hàng
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
