@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Order
@using ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Enums
@{ ViewData["Title"] = $"Order #{Model.Id}"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Order #@Model.Id</h1>
        <p class="admin-page-subtitle">@Model.OrderDate.ToString("dd MMM yyyy, HH:mm")</p>
    </div>
    <a asp-action="Index" class="admin-btn admin-btn--secondary"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div style="display:grid;grid-template-columns:2fr 1fr;gap:1.5rem;">
    <!-- Items Table -->
    <div>
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Unit Price</th>
                        <th>Qty</th>
                        <th style="text-align:right;">Subtotal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderDetails)
                    {
                        <tr>
                            <td><strong>@item.Product?.Name</strong></td>
                            <td>@item.UnitPrice.ToString("N0")đ</td>
                            <td>@item.Quantity</td>
                            <td style="text-align:right;font-weight:600;">@((item.UnitPrice * item.Quantity).ToString("N0"))đ</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    @if (Model.DiscountAmount > 0)
                    {
                        <tr>
                            <td colspan="3" style="text-align:right;">Subtotal:</td>
                            <td style="text-align:right;">@((Model.TotalAmount + Model.DiscountAmount).ToString("N0"))đ</td>
                        </tr>
                        <tr>
                            <td colspan="3" style="text-align:right;">Discount (@Model.CouponCode):</td>
                            <td style="text-align:right;color:#E53935;">-@Model.DiscountAmount.ToString("N0")đ</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="3" style="text-align:right;font-weight:700;">Total:</td>
                        <td style="text-align:right;font-weight:700;color:#6F4E37;font-size:1.1rem;">@Model.TotalAmount.ToString("N0")đ</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Sidebar -->
    <div>
        <!-- Customer Info -->
        <div style="background:#fff;border-radius:12px;padding:1.5rem;box-shadow:0 2px 8px rgba(0,0,0,0.04);margin-bottom:1rem;">
            <h4 style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:#7A7A7A;margin-bottom:0.75rem;">Customer Information</h4>
            <div class="admin-user-cell" style="margin-bottom:0.75rem;">
                <div class="admin-user-avatar">@(Model.User?.FullName?.Substring(0, 1).ToUpper() ?? "?")</div>
                <div>
                    <p class="admin-user-name">@Model.User?.FullName</p>
                    <p class="admin-user-email">@Model.User?.Email</p>
                </div>
            </div>
            <p style="font-size:0.85rem;margin-bottom:0.35rem;"><i class="fas fa-phone" style="width:16px;color:#C4A484;"></i> @Model.PhoneNumber</p>
            <p style="font-size:0.85rem;margin-bottom:0.35rem;"><i class="fas fa-map-marker-alt" style="width:16px;color:#C4A484;"></i> @Model.ShippingAddress</p>
            @if (!string.IsNullOrEmpty(Model.Notes))
            {
                <p style="font-size:0.85rem;"><i class="fas fa-sticky-note" style="width:16px;color:#C4A484;"></i> @Model.Notes</p>
            }
        </div>

        <!-- Update Status -->
        <div style="background:#fff;border-radius:12px;padding:1.5rem;box-shadow:0 2px 8px rgba(0,0,0,0.04);">
            <h4 style="font-size:0.75rem;font-weight:600;text-transform:uppercase;letter-spacing:1px;color:#7A7A7A;margin-bottom:0.75rem;">Update Status</h4>
            <form asp-action="UpdateStatus" method="post">
                <input type="hidden" name="id" value="@Model.Id" />
                <select name="status" class="admin-form-input admin-form-select" style="margin-bottom:0.75rem;">
                    <option value="@OrderStatus.Pending" selected="@(Model.Status == OrderStatus.Pending)">Pending</option>
                    <option value="@OrderStatus.Processing" selected="@(Model.Status == OrderStatus.Processing)">Processing</option>
                    <option value="@OrderStatus.Completed" selected="@(Model.Status == OrderStatus.Completed)">Completed</option>
                    <option value="@OrderStatus.Cancelled" selected="@(Model.Status == OrderStatus.Cancelled)">Cancelled</option>
                </select>
                <button type="submit" class="admin-btn admin-btn--primary" style="width:100%;"><i class="fas fa-save"></i> Update</button>
            </form>
        </div>
    </div>
</div>
