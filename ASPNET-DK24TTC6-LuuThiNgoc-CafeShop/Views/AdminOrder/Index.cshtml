@model List<ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Order>
@using ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Enums
@{ ViewData["Title"] = "Orders"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Orders</h1>
        <p class="admin-page-subtitle">View and manage all customer orders.</p>
    </div>
</div>

<div class="admin-table-controls">
    <div class="admin-search-box">
        <i class="fas fa-search"></i>
        <input type="text" placeholder="Search orders..." />
    </div>
    <span style="font-size:0.85rem;color:#7A7A7A;">@Model.Count orders total</span>
</div>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Order</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Total</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td><strong style="color:#6F4E37;">#@order.Id</strong></td>
                    <td>
                        <div class="admin-user-cell">
                            <div class="admin-user-avatar">@(order.User?.FullName?.Substring(0, 1).ToUpper() ?? "?")</div>
                            <div>
                                <p class="admin-user-name">@(order.User?.FullName ?? "N/A")</p>
                                <p class="admin-user-email">@order.User?.Email</p>
                            </div>
                        </div>
                    </td>
                    <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td style="font-weight:600;">@order.TotalAmount.ToString("N0")đ</td>
                    <td>
                        @switch (order.Status)
                        {
                            case OrderStatus.Pending:
                                <span class="status-dot status-dot--pending">Pending</span>
                                break;
                            case OrderStatus.Processing:
                                <span class="status-dot status-dot--processing">Processing</span>
                                break;
                            case OrderStatus.Completed:
                                <span class="status-dot status-dot--completed">Completed</span>
                                break;
                            case OrderStatus.Cancelled:
                                <span class="status-dot status-dot--cancelled">Cancelled</span>
                                break;
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@order.Id" class="admin-btn admin-btn--ghost" title="View"><i class="fas fa-eye"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
