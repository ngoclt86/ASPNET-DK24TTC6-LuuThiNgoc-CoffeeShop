@model List<ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Order>
@using ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Enums
@{ ViewData["Title"] = "Orders"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title" data-i18n="aorder.title">Quản lý đơn hàng</h1>
        <p class="admin-page-subtitle" data-i18n="aorder.subtitle">Theo dõi và xử lý đơn hàng.</p>
    </div>
</div>

<form asp-action="Index" method="get" class="admin-table-controls product-controls">
    <div class="product-controls__filters">
        <div class="admin-search-box product-controls__search">
            <i class="fas fa-search"></i>
            <input type="text" name="search" value="@ViewData["CurrentSearch"]" placeholder="Tìm kiếm đơn hàng..." data-i18n-ph="common.search_orders" />
        </div>
        <button type="submit" class="admin-btn admin-btn--secondary product-controls__submit" data-i18n="common.search">Tìm kiếm</button>
        @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"] as string))
        {
            <a asp-action="Index" class="admin-btn admin-btn--ghost" style="padding:0; min-height:40px; display:flex; align-items:center; justify-content:center; width:40px;" title="Xóa bộ lọc"><i class="fas fa-times"></i></a>
        }
    </div>
    <div class="product-controls__meta">
        <span class="product-controls__count">@Model.Count đơn hàng</span>
    </div>
</form>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th>Order</th>
                <th data-i18n="aorder.customer">Khách hàng</th>
                <th data-i18n="aorder.date">Ngày đặt</th>
                <th data-i18n="aorder.total_col">Tổng tiền</th>
                <th data-i18n="aorder.status">Trạng thái</th>
                <th data-i18n="aorder.actions">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td><strong style="color:#6F4E37;">#@order.Id</strong></td>
                    <td>
                        <div class="admin-user-cell">
                            <div class="admin-user-avatar">@(order.User?.FullName?.Substring(0, 1).ToUpper() ?? "?")</div>
                            <div>
                                <p class="admin-user-name">@(order.User?.FullName ?? "N/A")</p>
                                <p class="admin-user-email">@order.User?.Email</p>
                            </div>
                        </div>
                    </td>
                    <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td style="font-weight:600;">@order.TotalAmount.ToString("N0")đ</td>
                    <td>
                        @switch (order.Status)
                        {
                            case OrderStatus.Pending:
                                <span class="status-dot status-dot--pending" data-i18n="status.pending">Chờ xử lý</span>
                                break;
                            case OrderStatus.Processing:
                                <span class="status-dot status-dot--processing" data-i18n="status.processing">Đang xử lý</span>
                                break;
                            case OrderStatus.Completed:
                                <span class="status-dot status-dot--completed" data-i18n="status.completed">Hoàn thành</span>
                                break;
                            case OrderStatus.Cancelled:
                                <span class="status-dot status-dot--cancelled" data-i18n="status.cancelled">Đã hủy</span>
                                break;
                        }
                    </td>
                    <td>
                        <a asp-action="Details" asp-route-id="@order.Id" class="admin-btn admin-btn--ghost" title="View"><i class="fas fa-eye"></i></a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
