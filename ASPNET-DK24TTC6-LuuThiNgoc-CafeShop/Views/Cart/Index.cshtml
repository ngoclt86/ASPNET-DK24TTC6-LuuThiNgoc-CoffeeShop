@model List<ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.ViewModels.CartItem>
@{ ViewData["Title"] = "Giỏ hàng"; }

<div class="container py-4">
    <h2 class="section-title">Giỏ hàng</h2>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
            <p class="text-muted">Giỏ hàng trống</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary-custom">Xem sản phẩm</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>Sản phẩm</th><th>Giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    { <img src="@item.ImageUrl" class="product-thumb" alt="" /> }
                                    <span>@item.ProductName</span>
                                </div>
                            </td>
                            <td>@item.Price.ToString("N0")đ</td>
                            <td>
                                <form asp-action="Update" method="post" class="d-flex gap-1">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" class="form-control form-control-sm" style="width:70px" />
                                    <button class="btn btn-sm btn-outline-primary"><i class="fas fa-sync-alt"></i></button>
                                </form>
                            </td>
                            <td><strong>@item.Total.ToString("N0")đ</strong></td>
                            <td>
                                <form asp-action="Remove" method="post">
                                    <input type="hidden" name="productId" value="@item.ProductId" />
                                    <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center mt-3">
            <h4>Tổng: <strong class="text-primary">@ViewBag.Total.ToString("N0")đ</strong></h4>
            <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary-custom btn-lg">Thanh toán <i class="fas fa-arrow-right"></i></a>
        </div>
    }
</div>
