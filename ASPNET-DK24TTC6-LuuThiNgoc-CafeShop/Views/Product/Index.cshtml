@model List<ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Product>
@{
    ViewData["Title"] = "Shop";
    var categories = ViewBag.Categories as List<ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Category>;
}

<div class="shop-page">
    <!-- Header -->
    <div class="shop-header">
        <div class="container" style="display:flex;justify-content:space-between;align-items:flex-end;">
            <div>
                <h1 class="shop-header__title" data-i18n="shop.title">Bộ sưu tập<br/>Đặc biệt</h1>
                <p class="shop-header__desc" data-i18n="shop.desc">Các loại cà phê chọn lọc và đặc biệt theo mùa. Rang để tôn lên hương vị tự nhiên.</p>
            </div>
            <span class="shop-header__count"><span data-i18n="shop.showing">Hiển thị</span> @Model.Count <span data-i18n="shop.offerings">sản phẩm</span></span>
        </div>
    </div>

    <!-- Layout: Sidebar + Grid -->
    <div class="container">
        <div class="shop-layout">
            <!-- Sidebar Filters -->
            <aside class="shop-filter">
                <h3 class="shop-filter__title" data-i18n="shop.refine">Bộ lọc</h3>

                <div class="shop-filter__group">
                    <h4 class="shop-filter__group-title" data-i18n="shop.category">Danh mục</h4>
                    <a asp-action="Index" class="shop-filter__checkbox" style="text-decoration:none;color:var(--color-text);">
                        <input type="checkbox" checked disabled /> <span data-i18n="shop.all">Tất cả</span>
                    </a>
                    @if (categories != null)
                    {
                        @foreach (var cat in categories)
                        {
                            <a asp-action="Index" asp-route-categoryId="@cat.Id" class="shop-filter__checkbox" style="text-decoration:none;color:var(--color-text);">
                                <input type="checkbox" @(ViewBag.CurrentCategory != null && (int)ViewBag.CurrentCategory == cat.Id ? "checked" : "") disabled /> @cat.Name
                            </a>
                        }
                    }
                </div>
            </aside>

            <!-- Products Grid -->
            <div>
                @if (!Model.Any())
                {
                    <div class="empty-state">
                        <div class="empty-state__icon"><i class="fas fa-search"></i></div>
                        <p class="empty-state__text" data-i18n="shop.no_products">Không tìm thấy sản phẩm.</p>
                        <a asp-action="Index" class="btn-brew btn-brew--primary" data-i18n="shop.view_all">Xem tất cả</a>
                    </div>
                }
                else
                {
                    <!-- Search Bar -->
                    <form asp-action="Index" method="get" style="margin-bottom:1.5rem;">
                        <div class="admin-search-box" style="max-width:100%;">
                            <i class="fas fa-search"></i>
                            <input type="text" name="search" value="@ViewBag.CurrentSearch" placeholder="Tìm kiếm sản phẩm..." data-i18n-ph="common.search_products" />
                        </div>
                    </form>

                    <div class="products-grid">
                        @foreach (var product in Model)
                        {
                            <div class="product-card">
                                <a asp-action="Details" asp-route-id="@product.Id" style="text-decoration:none;">
                                    <div class="product-card__image">
                                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                                        {
                                            <img src="@product.ImageUrl" alt="@product.Name" />
                                        }
                                        else
                                        {
                                            <div class="product-card__placeholder"><i class="fas fa-coffee"></i></div>
                                        }
                                        <span class="product-card__badge product-card__badge--medium">@(product.Category?.Name ?? "Coffee")</span>
                                    </div>
                                </a>
                                <div class="product-card__body">
                                    <span class="product-card__origin">@(product.Category?.Name?.ToUpper() ?? "COFFEE")</span>
                                    <h5 class="product-card__name">
                                        <a asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                                    </h5>
                                    <p class="product-card__desc">@(product.Description?.Length > 60 ? product.Description.Substring(0, 60) + "..." : product.Description)</p>
                                    <div class="product-card__footer">
                                        <span class="product-card__price">@product.Price.ToString("N0")đ</span>
                                        <form asp-controller="Cart" asp-action="Add" method="post">
                                            <input type="hidden" name="productId" value="@product.Id" />
                                            <button type="submit" class="btn-brew btn-brew--primary btn-brew--sm" data-i18n="shop.add_to_cart">Thêm vào giỏ</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
