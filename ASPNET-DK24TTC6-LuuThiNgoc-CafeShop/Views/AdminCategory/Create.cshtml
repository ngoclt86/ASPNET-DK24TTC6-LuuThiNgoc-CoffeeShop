@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Category
@{ ViewData["Title"] = "New Category"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title" data-i18n="acat.create_title">Tạo danh mục mới</h1>
        <p class="admin-page-subtitle" data-i18n="acat.create_subtitle">Thêm danh mục sản phẩm mới.</p>
    </div>
    <a asp-action="Index" class="admin-btn admin-btn--secondary"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div style="background:#fff;border-radius:12px;padding:2rem;box-shadow:0 2px 8px rgba(0,0,0,0.04);max-width:500px;">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" style="color:#E53935;font-size:0.85rem;margin-bottom:1rem;"></div>
        <div class="admin-form-group">
            <label asp-for="Name" class="admin-form-label" data-i18n="acat.name">Tên danh mục</label>
            <input asp-for="Name" class="admin-form-input" placeholder="VD: Cà phê đen" data-i18n-ph="ph.category_name" />
            <span asp-validation-for="Name" style="color:#E53935;font-size:0.78rem;"></span>
        </div>
        <div class="admin-form-group">
            <label asp-for="Description" class="admin-form-label" data-i18n="acat.description">Mô tả</label>
            <textarea asp-for="Description" class="admin-form-input admin-form-textarea" rows="3" placeholder="Mô tả danh mục này..." data-i18n-ph="ph.category_desc"></textarea>
        </div>
        <div style="display:flex;gap:0.75rem;margin-top:1.5rem;padding-top:1rem;border-top:1px solid #f0f0f0;">
            <button type="submit" class="admin-btn admin-btn--primary"><i class="fas fa-save"></i> <span data-i18n="acat.save">Lưu danh mục</span></button>
            <a asp-action="Index" class="admin-btn admin-btn--ghost" data-i18n="common.cancel">Hủy</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
