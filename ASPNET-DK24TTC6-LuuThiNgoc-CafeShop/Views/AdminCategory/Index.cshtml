@model List<ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Category>
@{ ViewData["Title"] = "Quản lý loại sản phẩm"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Tổng: @Model.Count loại sản phẩm</p>
    <a asp-action="Create" class="btn btn-admin-primary"><i class="fas fa-plus"></i> Thêm mới</a>
</div>

<div class="admin-table">
    <table class="table">
        <thead>
            <tr><th>#</th><th>Tên loại</th><th>Mô tả</th><th>Ngày tạo</th><th>Thao tác</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td><strong>@item.Name</strong></td>
                    <td>@(item.Description ?? "—")</td>
                    <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn chắc chắn xóa?')">
                            <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
