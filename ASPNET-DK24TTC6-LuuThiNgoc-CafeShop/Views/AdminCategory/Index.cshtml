@model List<ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Category>
@{ ViewData["Title"] = "Categories"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title" data-i18n="acat.title">Quản lý danh mục</h1>
        <p class="admin-page-subtitle" data-i18n="acat.subtitle">Tổ chức sản phẩm theo danh mục.</p>
    </div>
    <a asp-action="Create" class="admin-btn admin-btn--primary"><i class="fas fa-plus"></i> <span data-i18n="acat.add">Thêm danh mục</span></a>
</div>

<div class="category-cards-grid">
    @foreach (var item in Model)
    {
        <div class="admin-category-card">
            <div class="admin-category-card__header">
                <div class="admin-category-card__icon"><i class="fas fa-mug-hot"></i></div>
                <div class="admin-category-card__actions">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="admin-btn admin-btn--ghost" title="Edit"><i class="fas fa-pen"></i></a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Are you sure?')">
                        <button class="admin-btn admin-btn--ghost" style="color:#E53935;" title="Delete"><i class="fas fa-trash-alt"></i></button>
                    </form>
                </div>
            </div>
            <h3 class="admin-category-card__name">@item.Name</h3>
            <p class="admin-category-card__desc">@(item.Description ?? "No description")</p>
            <div class="admin-category-card__footer">
                <span><i class="fas fa-calendar"></i> @item.CreatedAt.ToString("dd/MM/yyyy")</span>
                <span><i class="fas fa-box"></i> @(item.Products?.Count ?? 0) <span data-i18n="acat.products_count">sản phẩm</span></span>
            </div>
        </div>
    }
</div>
