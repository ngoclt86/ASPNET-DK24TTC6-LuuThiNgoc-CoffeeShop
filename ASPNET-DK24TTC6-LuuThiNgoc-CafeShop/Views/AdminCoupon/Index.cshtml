@model List<ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Coupon>
@{ ViewData["Title"] = "Coupons"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title" data-i18n="acoupon.title">Quản lý mã giảm giá</h1>
        <p class="admin-page-subtitle" data-i18n="acoupon.subtitle">Tạo và quản lý mã ưu đãi.</p>
    </div>
    <a asp-action="Create" class="admin-btn admin-btn--primary"><i class="fas fa-plus"></i> <span data-i18n="acoupon.add">Tạo mã mới</span></a>
</div>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th data-i18n="acoupon.code">Mã</th>
                <th data-i18n="acoupon.discount">Giảm giá</th>
                <th data-i18n="acoupon.expiry">Ngày hết hạn</th>
                <th data-i18n="acoupon.usage">Sử dụng</th>
                <th data-i18n="acoupon.status">Trạng thái</th>
                <th data-i18n="acoupon.actions">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var coupon in Model)
            {
                var usagePercent = coupon.MaxUsage > 0 ? (double)coupon.CurrentUsage / coupon.MaxUsage * 100 : 0;
                <tr>
                    <td><code style="background:rgba(111,78,55,0.08);color:#6F4E37;padding:0.2rem 0.5rem;border-radius:4px;font-weight:600;">@coupon.Code</code></td>
                    <td style="font-weight:600;">@coupon.DiscountPercent%</td>
                    <td>@coupon.ExpiryDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div style="display:flex;align-items:center;gap:0.5rem;">
                            <span class="usage-bar">
                                <span class="usage-bar__fill" style="width:@usagePercent%"></span>
                            </span>
                            <span style="font-size:0.82rem;">@coupon.CurrentUsage/@coupon.MaxUsage</span>
                        </div>
                    </td>
                    <td>
                        @if (coupon.IsActive && coupon.ExpiryDate > DateTime.Now)
                        {
                            <span class="status-dot status-dot--active" data-i18n="status.active">Hoạt động</span>
                        }
                        else
                        {
                            <span class="status-dot status-dot--inactive" data-i18n="status.inactive">Không hoạt động</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@coupon.Id" class="admin-btn admin-btn--ghost" title="Edit"><i class="fas fa-pen"></i></a>
                        <button type="button"
                                class="admin-btn admin-btn--ghost"
                                style="color:#E53935;"
                                title="Delete"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteCouponModal"
                                data-coupon-id="@coupon.Id"
                                data-coupon-code="@coupon.Code">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="modal fade delete-coupon-modal" id="deleteCouponModal" tabindex="-1" aria-labelledby="deleteCouponModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteCouponModalLabel" data-i18n="acoupon.delete_title">Xác nhận xóa mã giảm giá</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="delete-product-modal__message"><span data-i18n="acoupon.delete_msg_prefix">Bạn có chắc muốn xóa mã giảm giá </span><strong id="deleteCouponCode"></strong><span data-i18n="acoupon.delete_msg_suffix">?</span></p>
                <p class="delete-product-modal__hint" data-i18n="acoupon.delete_hint">Hành động này không thể hoàn tác.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="admin-btn admin-btn--secondary" data-bs-dismiss="modal" data-i18n="common.cancel">Hủy</button>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteCouponId" />
                    <button type="submit" class="admin-btn admin-btn--danger" data-i18n="common.delete">Xóa</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteCouponModal = document.getElementById('deleteCouponModal');
        if (deleteCouponModal) {
            $(deleteCouponModal).on('show.bs.modal', function (event) {
                const triggerButton = event.relatedTarget;
                const couponId = triggerButton?.getAttribute('data-coupon-id');
                const couponCode = triggerButton?.getAttribute('data-coupon-code') || '';

                const idField = deleteCouponModal.querySelector('#deleteCouponId');
                const codeField = deleteCouponModal.querySelector('#deleteCouponCode');

                if (idField) {
                    idField.value = couponId || '';
                }

                if (codeField) {
                    codeField.textContent = couponCode;
                }
            });
        }
    </script>
}
