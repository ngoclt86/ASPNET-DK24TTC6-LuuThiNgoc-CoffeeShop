@model List<ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Coupon>
@{ ViewData["Title"] = "Quản lý mã giảm giá"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Tổng: @Model.Count mã giảm giá</p>
    <a asp-action="Create" class="btn btn-admin-primary"><i class="fas fa-plus"></i> Thêm mới</a>
</div>

<div class="admin-table">
    <table class="table">
        <thead>
            <tr><th>Mã</th><th>Giảm (%)</th><th>Hết hạn</th><th>Đã dùng / Tối đa</th><th>Trạng thái</th><th>Thao tác</th></tr>
        </thead>
        <tbody>
            @foreach (var coupon in Model)
            {
                <tr>
                    <td><code>@coupon.Code</code></td>
                    <td>@coupon.DiscountPercent%</td>
                    <td>@coupon.ExpiryDate.ToString("dd/MM/yyyy")</td>
                    <td>@coupon.CurrentUsage / @coupon.MaxUsage</td>
                    <td>
                        @if (coupon.IsActive && coupon.ExpiryDate > DateTime.Now)
                        { <span class="badge bg-success">Hoạt động</span> }
                        else
                        { <span class="badge bg-secondary">Hết hạn</span> }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@coupon.Id" class="btn btn-sm btn-outline-primary"><i class="fas fa-edit"></i></a>
                        <form asp-action="Delete" asp-route-id="@coupon.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn chắc chắn xóa?')">
                            <button class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
