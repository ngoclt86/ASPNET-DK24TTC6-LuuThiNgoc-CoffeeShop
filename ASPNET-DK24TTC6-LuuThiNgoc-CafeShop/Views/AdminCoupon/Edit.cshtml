@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.Coupon
@{ ViewData["Title"] = "Edit Coupon"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Edit Coupon</h1>
        <p class="admin-page-subtitle">Update coupon details.</p>
    </div>
    <a asp-action="Index" class="admin-btn admin-btn--secondary"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div style="background:#fff;border-radius:12px;padding:2rem;box-shadow:0 2px 8px rgba(0,0,0,0.04);max-width:500px;">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="CurrentUsage" />
        <div asp-validation-summary="ModelOnly" style="color:#E53935;font-size:0.85rem;margin-bottom:1rem;"></div>

        <div class="admin-form-group">
            <label asp-for="Code" class="admin-form-label">Coupon Code</label>
            <input asp-for="Code" class="admin-form-input" style="text-transform:uppercase;" />
        </div>

        <div class="admin-form-row">
            <div class="admin-form-group">
                <label asp-for="DiscountPercent" class="admin-form-label">Discount (%)</label>
                <input asp-for="DiscountPercent" class="admin-form-input" type="number" min="1" max="100" />
            </div>
            <div class="admin-form-group">
                <label asp-for="MaxUsage" class="admin-form-label">Max Usage</label>
                <input asp-for="MaxUsage" class="admin-form-input" type="number" min="1" />
            </div>
        </div>

        <div class="admin-form-group">
            <label asp-for="ExpiryDate" class="admin-form-label">Expiry Date</label>
            <input asp-for="ExpiryDate" class="admin-form-input" type="date" />
        </div>

        <div class="admin-form-group" style="display:flex;align-items:center;gap:0.5rem;">
            <input asp-for="IsActive" style="accent-color:#6F4E37;width:18px;height:18px;" />
            <label asp-for="IsActive" style="font-size:0.88rem;font-weight:500;">Active</label>
        </div>

        <div style="display:flex;gap:0.75rem;margin-top:1.5rem;padding-top:1rem;border-top:1px solid #f0f0f0;">
            <button type="submit" class="admin-btn admin-btn--primary"><i class="fas fa-save"></i> Update Coupon</button>
            <a asp-action="Index" class="admin-btn admin-btn--ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
