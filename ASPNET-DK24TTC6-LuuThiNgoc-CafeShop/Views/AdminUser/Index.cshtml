@model List<ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.Models.ApplicationUser>
@{ ViewData["Title"] = "Users"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title" data-i18n="auser.title">Quản lý người dùng</h1>
        <p class="admin-page-subtitle" data-i18n="auser.subtitle">Quản lý tài khoản người dùng.</p>
    </div>
</div>

<form asp-action="Index" method="get" class="admin-table-controls product-controls">
    <div class="product-controls__filters">
        <div class="admin-search-box product-controls__search">
            <i class="fas fa-search"></i>
            <input type="text" name="search" value="@ViewData["CurrentSearch"]" placeholder="Tìm kiếm người dùng..." data-i18n-ph="common.search_users" />
        </div>
        <button type="submit" class="admin-btn admin-btn--secondary product-controls__submit" data-i18n="common.search">Tìm kiếm</button>
        @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"] as string))
        {
            <a asp-action="Index" class="admin-btn admin-btn--ghost" style="padding:0; min-height:40px; display:flex; align-items:center; justify-content:center; width:40px;" title="Xóa bộ lọc"><i class="fas fa-times"></i></a>
        }
    </div>
    <div class="product-controls__meta">
        <span class="product-controls__count">@Model.Count người dùng</span>
    </div>
</form>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th data-i18n="auser.name">Người dùng</th>
                <th>Address</th>
                <th>Joined</th>
                <th data-i18n="auser.status">Trạng thái</th>
                <th data-i18n="auser.actions">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>
                        <div class="admin-user-cell">
                            <div class="admin-user-avatar">@(user.FullName?.Substring(0, 1).ToUpper() ?? "?")</div>
                            <div>
                                <p class="admin-user-name">@user.FullName</p>
                                <p class="admin-user-email">@user.Email</p>
                            </div>
                        </div>
                    </td>
                    <td style="font-size:0.85rem;">@(user.Address ?? "—")</td>
                    <td>@user.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (user.IsLocked)
                        {
                            <span class="status-dot status-dot--cancelled">Locked</span>
                        }
                        else
                        {
                            <span class="status-dot status-dot--active">Active</span>
                        }
                    </td>
                    <td>
                        <form asp-action="ToggleLock" asp-route-id="@user.Id" method="post" style="display:inline;">
                            @if (user.IsLocked)
                            {
                                <button class="admin-btn admin-btn--ghost" style="color:#4CAF50;" title="Unlock"><i class="fas fa-unlock"></i></button>
                            }
                            else
                            {
                                <button class="admin-btn admin-btn--ghost" style="color:#E53935;" title="Lock"><i class="fas fa-lock"></i></button>
                            }
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
