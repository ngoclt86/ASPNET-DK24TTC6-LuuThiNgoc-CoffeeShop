@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.ViewModels.ProductViewModel
@{ ViewData["Title"] = "New Product"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title" data-i18n="aproduct.create_title">Tạo sản phẩm mới</h1>
        <p class="admin-page-subtitle" data-i18n="aproduct.create_subtitle">Thêm sản phẩm mới vào kho.</p>
    </div>
    <a asp-action="Index" class="admin-btn admin-btn--secondary"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div style="background:#fff;border-radius:12px;padding:2rem;box-shadow:0 2px 8px rgba(0,0,0,0.04);max-width:700px;">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" style="color:#E53935;font-size:0.85rem;margin-bottom:1rem;"></div>

        <div class="admin-form-row">
            <div class="admin-form-group">
                <label asp-for="Name" class="admin-form-label" data-i18n="aproduct.name">Tên sản phẩm</label>
                <input asp-for="Name" class="admin-form-input" placeholder="VD: Cà Phê Đen Đá" data-i18n-ph="ph.product_name" />
                <span asp-validation-for="Name" style="color:#E53935;font-size:0.78rem;"></span>
            </div>
            <div class="admin-form-group">
                <label asp-for="CategoryId" class="admin-form-label" data-i18n="aproduct.category">Danh mục</label>
                <select asp-for="CategoryId" asp-items="@ViewBag.Categories" class="admin-form-input admin-form-select">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="CategoryId" style="color:#E53935;font-size:0.78rem;"></span>
            </div>
        </div>

        <div class="admin-form-group">
            <label asp-for="Description" class="admin-form-label" data-i18n="aproduct.description">Mô tả</label>
            <textarea asp-for="Description" class="admin-form-input admin-form-textarea" placeholder="Mô tả sản phẩm..." rows="3" data-i18n-ph="ph.product_desc"></textarea>
        </div>

        <div class="admin-form-row">
            <div class="admin-form-group">
                <label asp-for="Price" class="admin-form-label" data-i18n="aproduct.price">Giá</label>
                <input asp-for="Price" class="admin-form-input" type="number" step="1000" placeholder="50000" />
                <span asp-validation-for="Price" style="color:#E53935;font-size:0.78rem;"></span>
            </div>
            <div class="admin-form-group">
                <label asp-for="Stock" class="admin-form-label" data-i18n="aproduct.stock">Tồn kho</label>
                <input asp-for="Stock" class="admin-form-input" type="number" placeholder="100" />
            </div>
        </div>

        <div class="admin-form-group">
            <label asp-for="ImageFile" class="admin-form-label" data-i18n="aproduct.image">Hình ảnh sản phẩm</label>
            <div class="upload-area">
                <div class="upload-area__icon"><i class="fas fa-cloud-upload-alt"></i></div>
                <p class="upload-area__text"><strong>Click to upload</strong> or drag and drop</p>
                <p class="upload-area__hint">PNG, JPG up to 5MB</p>
                <input asp-for="ImageFile" type="file" accept="image/*" style="margin-top:0.75rem;" />
            </div>
            <p style="font-size:0.75rem;color:#aaa;margin-top:0.35rem;">Nếu có cả file và URL, hệ thống sẽ ưu tiên dùng file upload.</p>
            <span asp-validation-for="ImageFile" style="color:#E53935;font-size:0.78rem;"></span>
        </div>

        <div class="admin-form-group">
            <label asp-for="ImageUrlInput" class="admin-form-label">URL hình ảnh</label>
            <input asp-for="ImageUrlInput" class="admin-form-input" type="url" placeholder="https://example.com/image.jpg" />
            <p style="font-size:0.75rem;color:#aaa;margin-top:0.25rem;">Nếu không upload file, hệ thống sẽ tải ảnh từ URL này và lưu vào local.</p>
            <span asp-validation-for="ImageUrlInput" style="color:#E53935;font-size:0.78rem;"></span>
        </div>

        <div class="admin-form-group">
            <label class="admin-form-label">Preview ảnh mới</label>
            <div style="display:flex;gap:1rem;flex-wrap:wrap;">
                <div id="createFilePreviewContainer" style="display:none;">
                    <div class="admin-product-thumb" style="width:64px;height:64px;">
                        <img id="createFilePreviewImage" src="" alt="File preview" />
                    </div>
                    <p style="font-size:0.78rem;color:#7A7A7A;margin-top:0.35rem;">Ảnh từ file</p>
                </div>
                <div id="createUrlPreviewContainer" style="display:none;">
                    <div class="admin-product-thumb" style="width:64px;height:64px;">
                        <img id="createUrlPreviewImage" src="" alt="URL preview" />
                    </div>
                    <p style="font-size:0.78rem;color:#7A7A7A;margin-top:0.35rem;">Ảnh từ URL</p>
                </div>
            </div>
        </div>

        <div class="admin-form-group" style="display:flex;align-items:center;gap:0.5rem;">
            <input asp-for="IsActive" style="accent-color:#6F4E37;width:18px;height:18px;" />
            <label asp-for="IsActive" style="font-size:0.88rem;font-weight:500;">Active (visible to customers)</label>
        </div>

        <div style="display:flex;gap:0.75rem;margin-top:1.5rem;padding-top:1rem;border-top:1px solid #f0f0f0;">
            <button type="submit" class="admin-btn admin-btn--primary"><i class="fas fa-save"></i> <span data-i18n="aproduct.save">Lưu sản phẩm</span></button>
            <a asp-action="Index" class="admin-btn admin-btn--ghost" data-i18n="common.cancel">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const fileInput = document.getElementById("ImageFile");
            const urlInput = document.getElementById("ImageUrlInput");

            const fileContainer = document.getElementById("createFilePreviewContainer");
            const fileImage = document.getElementById("createFilePreviewImage");

            const urlContainer = document.getElementById("createUrlPreviewContainer");
            const urlImage = document.getElementById("createUrlPreviewImage");

            const showFilePreview = () => {
                const file = fileInput?.files?.[0];
                if (!file) {
                    fileContainer.style.display = "none";
                    fileImage.src = "";
                    return;
                }

                const reader = new FileReader();
                reader.onload = (e) => {
                    fileImage.src = e.target?.result || "";
                    fileContainer.style.display = "block";
                };
                reader.readAsDataURL(file);
            };

            const showUrlPreview = () => {
                const rawValue = urlInput?.value?.trim() || "";
                if (!rawValue) {
                    urlContainer.style.display = "none";
                    urlImage.src = "";
                    return;
                }

                urlImage.src = rawValue;
                urlContainer.style.display = "block";
            };

            fileInput?.addEventListener("change", showFilePreview);
            urlInput?.addEventListener("input", showUrlPreview);

            showFilePreview();
            showUrlPreview();
        })();
    </script>
}
