@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.ViewModels.ProductViewModel
@{ ViewData["Title"] = "Edit Product"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title">Edit Product</h1>
        <p class="admin-page-subtitle">Update the product details below.</p>
    </div>
    <a asp-action="Index" class="admin-btn admin-btn--secondary"><i class="fas fa-arrow-left"></i> Back</a>
</div>

<div style="background:#fff;border-radius:12px;padding:2rem;box-shadow:0 2px 8px rgba(0,0,0,0.04);max-width:700px;">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" style="color:#E53935;font-size:0.85rem;margin-bottom:1rem;"></div>

        <div class="admin-form-row">
            <div class="admin-form-group">
                <label asp-for="Name" class="admin-form-label">Product Name</label>
                <input asp-for="Name" class="admin-form-input" />
                <span asp-validation-for="Name" style="color:#E53935;font-size:0.78rem;"></span>
            </div>
            <div class="admin-form-group">
                <label asp-for="CategoryId" class="admin-form-label">Category</label>
                <select asp-for="CategoryId" asp-items="@ViewBag.Categories" class="admin-form-input admin-form-select"></select>
            </div>
        </div>

        <div class="admin-form-group">
            <label asp-for="Description" class="admin-form-label">Description</label>
            <textarea asp-for="Description" class="admin-form-input admin-form-textarea" rows="3"></textarea>
        </div>

        <div class="admin-form-row">
            <div class="admin-form-group">
                <label asp-for="Price" class="admin-form-label">Price (VNĐ)</label>
                <input asp-for="Price" class="admin-form-input" type="number" step="1000" />
            </div>
            <div class="admin-form-group">
                <label asp-for="Stock" class="admin-form-label">Stock</label>
                <input asp-for="Stock" class="admin-form-input" type="number" />
            </div>
        </div>

        <div class="admin-form-group">
            <label class="admin-form-label">Product Image</label>
            @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
            {
                <input type="hidden" asp-for="ExistingImageUrl" />
                <div style="margin-bottom:0.75rem;display:flex;align-items:center;gap:1rem;">
                    <div class="admin-product-thumb" style="width:64px;height:64px;">
                        <img src="@Model.ExistingImageUrl" alt="Current" />
                    </div>
                    <span style="font-size:0.82rem;color:#7A7A7A;">Current image</span>
                </div>
            }
            <input asp-for="ImageFile" type="file" accept="image/*" class="admin-form-input" />
            <p style="font-size:0.75rem;color:#aaa;margin-top:0.25rem;">Leave empty to keep current image</p>
        </div>

        <div class="admin-form-group" style="display:flex;align-items:center;gap:0.5rem;">
            <input asp-for="IsActive" style="accent-color:#6F4E37;width:18px;height:18px;" />
            <label asp-for="IsActive" style="font-size:0.88rem;font-weight:500;">Active</label>
        </div>

        <div style="display:flex;gap:0.75rem;margin-top:1.5rem;padding-top:1rem;border-top:1px solid #f0f0f0;">
            <button type="submit" class="admin-btn admin-btn--primary"><i class="fas fa-save"></i> Update Product</button>
            <a asp-action="Index" class="admin-btn admin-btn--ghost">Cancel</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
