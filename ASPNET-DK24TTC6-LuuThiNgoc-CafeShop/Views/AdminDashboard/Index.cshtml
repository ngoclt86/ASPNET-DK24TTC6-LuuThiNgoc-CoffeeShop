@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.ViewModels.DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title" data-i18n="dash.title">Tổng quan cửa hàng</h1>
        <p class="admin-page-subtitle" data-i18n="dash.subtitle">Theo dõi hiệu suất kinh doanh của bạn.</p>
    </div>
</div>

<!-- Stat Cards -->
<div class="stat-cards">
    <div class="stat-card">
        <div class="stat-card__header">
            <span class="stat-card__label"><i class="fas fa-dollar-sign"></i> <span data-i18n="dash.revenue">Doanh thu</span></span>
        </div>
        <p class="stat-card__value">@Model.TotalRevenue.ToString("N0")đ</p>
        <span class="stat-card__change stat-card__change--up"><i class="fas fa-arrow-up"></i> <span data-i18n="dash.total_revenue">Tổng doanh thu</span></span>
    </div>
    <div class="stat-card">
        <div class="stat-card__header">
            <span class="stat-card__label"><i class="fas fa-shopping-bag"></i> <span data-i18n="dash.orders_label">Đơn hàng</span></span>
        </div>
        <p class="stat-card__value">@Model.TotalOrders</p>
        <span class="stat-card__change stat-card__change--up"><i class="fas fa-arrow-up"></i> <span data-i18n="dash.total_orders">Tổng đơn hàng</span></span>
    </div>
    <div class="stat-card">
        <div class="stat-card__header">
            <span class="stat-card__label"><i class="fas fa-box"></i> <span data-i18n="dash.products_label">Sản phẩm</span></span>
        </div>
        <p class="stat-card__value">@Model.TotalProducts</p>
        <span class="stat-card__change" data-i18n="dash.active_inventory">Sản phẩm đang bán</span>
    </div>
    <div class="stat-card">
        <div class="stat-card__header">
            <span class="stat-card__label"><i class="fas fa-users"></i> <span data-i18n="dash.customers">Khách hàng</span></span>
        </div>
        <p class="stat-card__value">@Model.TotalUsers</p>
        <span class="stat-card__change stat-card__change--up"><i class="fas fa-arrow-up"></i> <span data-i18n="dash.registered_users">Người dùng đã đăng ký</span></span>
    </div>
</div>

<!-- Charts Section -->
<div class="chart-section">
    <div class="chart-card revenue-chart-card">
        <div class="chart-card__header">
            <div>
                <h3 class="chart-card__title" data-i18n="dash.revenue_trends">Xu hướng doanh thu</h3>
                <p class="chart-card__subtitle">Monthly revenue for @ViewData["SelectedYear"]</p>
            </div>
        </div>
        <div class="chart-canvas-wrap chart-canvas-wrap--revenue">
            <canvas id="revenueChart"></canvas>
        </div>
    </div>
    <div class="chart-card">
        <div class="chart-card__header">
            <h3 class="chart-card__title" data-i18n="dash.by_category">Doanh thu theo danh mục</h3>
        </div>
        <div id="categoryChartEmptyState" class="chart-card__empty-state" hidden>Chưa có dữ liệu doanh thu theo danh mục.</div>
        <canvas id="categoryChart" height="250"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        const monthlyLabels = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyRevenue.Select(m => $"Month {m.Month}")));
        const monthlyData = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyRevenue.Select(m => Math.Round(m.Revenue, 0))));

        const categoryLabels = @Html.Raw(JsonSerializer.Serialize(Model.RevenueByCategory.Select(c => c.CategoryName)));
        const categoryData = @Html.Raw(JsonSerializer.Serialize(Model.RevenueByCategory.Select(c => Math.Round(c.Revenue, 0))));
        const categoryColors = ['#6F4E37', '#C4A484', '#D2691E', '#8B6914', '#A0522D', '#DEB887'];

        function createOrUpdateChart(canvasId, config) {
            const canvas = document.getElementById(canvasId);
            if (!canvas) {
                return null;
            }

            const existingChart = Chart.getChart(canvas);
            if (existingChart) {
                existingChart.destroy();
            }

            return new Chart(canvas, config);
        }

        function initializeDashboardCharts() {
            createOrUpdateChart('revenueChart', {
                type: 'bar',
                data: {
                    labels: monthlyLabels,
                    datasets: [{
                        label: 'Revenue (VNĐ)',
                        data: monthlyData,
                        backgroundColor: '#C4A484',
                        borderColor: '#6F4E37',
                        borderWidth: 1,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    resizeDelay: 300,
                    animation: false,
                    parsing: false,
                    normalized: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, grid: { color: 'rgba(0,0,0,0.04)' } },
                        x: { grid: { display: false } }
                    }
                }
            });

            const categoryCanvas = document.getElementById('categoryChart');
            const categoryEmptyState = document.getElementById('categoryChartEmptyState');
            const hasCategoryData = categoryData.some(value => value > 0);

            if (!hasCategoryData) {
                if (categoryCanvas) {
                    const existingChart = Chart.getChart(categoryCanvas);
                    if (existingChart) {
                        existingChart.destroy();
                    }

                    categoryCanvas.hidden = true;
                }

                if (categoryEmptyState) {
                    categoryEmptyState.hidden = false;
                }
            } else {
                if (categoryCanvas) {
                    categoryCanvas.hidden = false;
                }

                if (categoryEmptyState) {
                    categoryEmptyState.hidden = true;
                }

                createOrUpdateChart('categoryChart', {
                    type: 'doughnut',
                    data: {
                        labels: categoryLabels,
                        datasets: [{
                            data: categoryData,
                            backgroundColor: categoryColors.slice(0, categoryLabels.length),
                            borderWidth: 0
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        resizeDelay: 300,
                        animation: false,
                        cutout: '65%',
                        plugins: { legend: { position: 'bottom', labels: { font: { family: 'Poppins' } } } }
                    }
                });
            }
        }

        function scheduleChartInitialization() {
            window.requestAnimationFrame(initializeDashboardCharts);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', scheduleChartInitialization, { once: true });
        } else {
            scheduleChartInitialization();
        }
    </script>
}
