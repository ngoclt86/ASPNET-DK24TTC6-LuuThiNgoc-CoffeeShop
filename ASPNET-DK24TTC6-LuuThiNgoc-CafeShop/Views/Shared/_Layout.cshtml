@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The Sensorial Brew</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<!-- Navbar -->
<header>
    <nav class="navbar-brew">
        <div class="container">
            <a class="navbar-brew__brand" asp-controller="Home" asp-action="Index">The Sensorial Brew</a>

            <button class="navbar-brew__toggle" id="navToggle" aria-label="Toggle navigation">
                <i class="fas fa-bars"></i>
            </button>

            <ul class="navbar-brew__nav" id="navMenu">
                <li><a class="navbar-brew__link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a class="navbar-brew__link @(currentController == "Product" ? "active" : "")" asp-controller="Product" asp-action="Index">Shop</a></li>
                <li><a class="navbar-brew__link" href="#">Our Story</a></li>
                <li><a class="navbar-brew__link" href="#">Brew Guides</a></li>
            </ul>

            <ul class="navbar-brew__actions">
                <li>
                    <a class="navbar-brew__icon" asp-controller="Cart" asp-action="Index" title="Cart">
                        <i class="fas fa-shopping-bag"></i>
                    </a>
                </li>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <li>
                            <a class="navbar-brew__icon" asp-controller="AdminDashboard" asp-action="Index" title="Admin">
                                <i class="fas fa-cog"></i>
                            </a>
                        </li>
                    }
                    <li>
                        <a class="navbar-brew__icon" asp-controller="Order" asp-action="History" title="Orders">
                            <i class="fas fa-receipt"></i>
                        </a>
                    </li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button class="navbar-brew__icon" type="submit" title="Sign Out">
                                <i class="fas fa-sign-out-alt"></i>
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li>
                        <a class="navbar-brew__icon" asp-controller="Account" asp-action="Login" title="Sign In">
                            <i class="fas fa-user"></i>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </nav>
</header>

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="container" style="padding-top: 1rem;">
        <div class="alert-brew alert-brew--success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="container" style="padding-top: 1rem;">
        <div class="alert-brew alert-brew--error">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        </div>
    </div>
}

<main>
    @RenderBody()
</main>

<!-- Footer -->
<footer class="footer-brew">
    <div class="container">
        <div class="footer-brew__inner">
            <div>
                <span class="footer-brew__brand">Sensorial Brew</span>
                <p class="footer-brew__copy">&copy; 2024 The Sensorial Brew. Curated Rituals.</p>
            </div>
            <ul class="footer-brew__links">
                <li><a href="#">Privacy Policy</a></li>
                <li><a href="#">Terms of Service</a></li>
                <li><a href="#">Shipping Info</a></li>
                <li><a href="#">Contact Us</a></li>
            </ul>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    // Mobile nav toggle
    document.getElementById('navToggle')?.addEventListener('click', function() {
        document.getElementById('navMenu')?.classList.toggle('show');
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>