@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var successMessage = TempData["Success"]?.ToString();
    var errorMessage = TempData["Error"]?.ToString();
    var shouldShowStockToast = !string.IsNullOrWhiteSpace(errorMessage)
        && (errorMessage.Contains("không đủ", StringComparison.OrdinalIgnoreCase)
            || errorMessage.Contains("vượt tồn kho", StringComparison.OrdinalIgnoreCase)
            || errorMessage.Contains("tối đa", StringComparison.OrdinalIgnoreCase)
            || errorMessage.Contains("hết hàng", StringComparison.OrdinalIgnoreCase));
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CoffeeShop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<!-- Navbar -->
<header>
    <nav class="navbar-brew">
        <div class="container">
            <a class="navbar-brew__brand" asp-controller="Home" asp-action="Index">CoffeeShop</a>

            <button class="navbar-brew__toggle" id="navToggle" aria-label="Toggle navigation">
                <i class="fas fa-bars"></i>
            </button>

            <ul class="navbar-brew__nav" id="navMenu">
                <li><a class="navbar-brew__link @(currentController == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index" data-i18n="nav.home">Trang chủ</a></li>
                <li><a class="navbar-brew__link @(currentController == "Product" ? "active" : "")" asp-controller="Product" asp-action="Index" data-i18n="nav.shop">Cửa hàng</a></li>
                <li><a class="navbar-brew__link" href="#" data-i18n="nav.our_story">Câu chuyện</a></li>
                <li><a class="navbar-brew__link" href="#" data-i18n="nav.guides">Hướng dẫn</a></li>
            </ul>

            <ul class="navbar-brew__actions">
                <li>
                    <button class="lang-toggle" id="langToggle" onclick="CoffeeI18n.toggleLanguage()">
                        <i class="fas fa-globe"></i> EN
                    </button>
                </li>
                <li>
                    <a class="navbar-brew__icon" asp-controller="Cart" asp-action="Index" title="Cart">
                        <i class="fas fa-shopping-bag"></i>
                    </a>
                </li>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <li>
                            <a class="navbar-brew__icon" asp-controller="AdminDashboard" asp-action="Index" title="Admin">
                                <i class="fas fa-cog"></i>
                            </a>
                        </li>
                    }
                    <li>
                        <a class="navbar-brew__icon" asp-controller="Order" asp-action="History" title="Orders">
                            <i class="fas fa-receipt"></i>
                        </a>
                    </li>
                    <li>
                        <a class="navbar-brew__icon" asp-controller="Account" asp-action="Profile" title="Profile">
                            <i class="fas fa-user-circle"></i>
                        </a>
                    </li>
                    <li>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button class="navbar-brew__icon" type="submit" title="Sign Out">
                                <i class="fas fa-sign-out-alt"></i>
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li>
                        <a class="navbar-brew__icon" asp-controller="Account" asp-action="Login" title="Sign In">
                            <i class="fas fa-user"></i>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </nav>
</header>

<!-- Alerts -->
@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="container" style="padding-top: 1rem;">
        <div class="alert-brew alert-brew--success">
            <i class="fas fa-check-circle"></i> @successMessage
        </div>
    </div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage) && !shouldShowStockToast)
{
    <div class="container" style="padding-top: 1rem;">
        <div class="alert-brew alert-brew--error">
            <i class="fas fa-exclamation-circle"></i> @errorMessage
        </div>
    </div>
}

@if (shouldShowStockToast)
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080;">
        <div id="stockErrorToast" class="toast align-items-center text-white bg-danger border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    @errorMessage
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>
}

<main>
    @RenderBody()
</main>

<!-- Footer -->
<footer class="footer-brew">
    <div class="container">
        <div class="footer-brew__inner">
            <div>
                <span class="footer-brew__brand">CoffeeShop</span>
                <p class="footer-brew__copy" data-i18n="footer.copy">© 2024 CoffeeShop. Tất cả quyền được bảo lưu.</p>
            </div>
            <ul class="footer-brew__links">
                <li><a href="#" data-i18n="footer.privacy">Chính sách bảo mật</a></li>
                <li><a href="#" data-i18n="footer.terms">Điều khoản dịch vụ</a></li>
                <li><a href="#" data-i18n="footer.shipping">Thông tin vận chuyển</a></li>
                <li><a href="#" data-i18n="footer.contact">Liên hệ</a></li>
            </ul>
        </div>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/i18n.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    // Mobile nav toggle
    document.getElementById('navToggle')?.addEventListener('click', function() {
        document.getElementById('navMenu')?.classList.toggle('show');
    });

    const stockErrorToastElement = document.getElementById('stockErrorToast');
    if (stockErrorToastElement) {
        const stockErrorToast = new bootstrap.Toast(stockErrorToastElement, { delay: 2800 });
        stockErrorToast.show();
    }
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>