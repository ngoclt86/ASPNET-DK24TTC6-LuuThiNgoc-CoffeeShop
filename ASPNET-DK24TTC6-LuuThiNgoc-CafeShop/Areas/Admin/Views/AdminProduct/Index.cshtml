@model ASPNET_DK24TTC6_LuuThiNgoc_CafeShop.ViewModels.AdminProductIndexViewModel
@{ ViewData["Title"] = "Inventory"; Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml"; }

@{
    var hasData = Model.Items.Count > 0;
    var startItem = hasData ? ((Model.Page - 1) * Model.PageSize) + 1 : 0;
    var endItem = hasData ? startItem + Model.Items.Count - 1 : 0;
}

<div class="admin-page-header">
    <div>
        <h1 class="admin-page-title" data-i18n="aproduct.title">Quản lý sản phẩm</h1>
        <p class="admin-page-subtitle" data-i18n="aproduct.subtitle">Quản lý kho sản phẩm của bạn.</p>
    </div>
    <a asp-action="Create" class="admin-btn admin-btn--primary"><i class="fas fa-plus"></i> <span data-i18n="aproduct.add">Thêm sản phẩm</span></a>
</div>

<form asp-action="Index" method="get" class="admin-table-controls product-controls">
    <div class="product-controls__filters">
        <div class="admin-search-box product-controls__search">
            <i class="fas fa-search"></i>
            <input type="text" name="search" value="@Model.Search" placeholder="Tìm kiếm sản phẩm..." id="productSearch" data-i18n-ph="common.search_products" />
        </div>
        <select name="sort" class="admin-filter-btn admin-sort-select product-controls__sort" onchange="this.form.submit()">
            <option value="newest" selected="@(Model.Sort == "newest" ? "selected" : null)">Mới nhất</option>
            <option value="oldest" selected="@(Model.Sort == "oldest" ? "selected" : null)">Cũ nhất</option>
            <option value="name_asc" selected="@(Model.Sort == "name_asc" ? "selected" : null)">Tên A-Z</option>
            <option value="name_desc" selected="@(Model.Sort == "name_desc" ? "selected" : null)">Tên Z-A</option>
            <option value="price_asc" selected="@(Model.Sort == "price_asc" ? "selected" : null)">Giá tăng dần</option>
            <option value="price_desc" selected="@(Model.Sort == "price_desc" ? "selected" : null)">Giá giảm dần</option>
        </select>
        <input type="hidden" name="page" value="1" />
        <button type="submit" class="admin-btn admin-btn--secondary product-controls__submit">Lọc</button>
    </div>
    <div class="product-controls__meta">
        <span class="product-controls__count">@Model.TotalItems sản phẩm</span>
    </div>
</form>

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th data-i18n="aproduct.name">Tên sản phẩm</th>
                <th data-i18n="aproduct.category">Danh mục</th>
                <th data-i18n="aproduct.price">Giá</th>
                <th data-i18n="aproduct.stock">Tồn kho</th>
                <th data-i18n="aproduct.status">Trạng thái</th>
                <th data-i18n="aproduct.actions">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (!hasData)
            {
                <tr>
                    <td colspan="6" style="text-align:center;color:#7A7A7A;padding:1.5rem;">
                        Không tìm thấy sản phẩm phù hợp.
                    </td>
                </tr>
            }

            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        <div class="admin-product-cell">
                            <div class="admin-product-thumb">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="@item.Name" />
                                }
                                else
                                {
                                    <div class="admin-product-thumb--placeholder"><i class="fas fa-coffee"></i></div>
                                }
                            </div>
                            <div>
                                <p class="admin-product-name">@item.Name</p>
                                <p class="admin-product-sub">ID: @item.Id</p>
                            </div>
                        </div>
                    </td>
                    <td>@item.Category?.Name</td>
                    <td style="font-weight:600;">@item.Price.ToString("N0")đ</td>
                    <td>@item.Stock</td>
                    <td>
                        @if (item.IsActive)
                        {
                            <span class="status-dot status-dot--active" data-i18n="status.active">Hoạt động</span>
                        }
                        else
                        {
                            <span class="status-dot status-dot--inactive" data-i18n="status.inactive">Không hoạt động</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="admin-btn admin-btn--ghost" title="Edit"><i class="fas fa-pen"></i></a>
                        <button type="button"
                                class="admin-btn admin-btn--ghost"
                                style="color:#E53935;"
                                title="Delete"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteProductModal"
                                data-product-id="@item.Id"
                                data-product-name="@item.Name">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.TotalPages > 1)
    {
        <div class="admin-pagination">
            <span>Hiển thị @startItem-@endItem trên @Model.TotalItems sản phẩm</span>
            <div class="admin-pagination__pages">
                @if (Model.Page > 1)
                {
                    <a class="admin-pagination__btn" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort">&laquo;</a>
                }

                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <a class="admin-pagination__btn @(pageNumber == Model.Page ? "active" : string.Empty)"
                       asp-action="Index"
                       asp-route-page="@pageNumber"
                       asp-route-search="@Model.Search"
                       asp-route-sort="@Model.Sort">
                        @pageNumber
                    </a>
                }

                @if (Model.Page < Model.TotalPages)
                {
                    <a class="admin-pagination__btn" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-sort="@Model.Sort">&raquo;</a>
                }
            </div>
        </div>
    }
</div>

<div class="modal fade delete-product-modal" id="deleteProductModal" tabindex="-1" aria-labelledby="deleteProductModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteProductModalLabel" data-i18n="aproduct.delete_title">Xác nhận xóa sản phẩm</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="delete-product-modal__message"><span data-i18n="aproduct.delete_msg_prefix">Bạn có chắc muốn xóa sản phẩm </span><strong id="deleteProductName"></strong><span data-i18n="aproduct.delete_msg_suffix">?</span></p>
                <p class="delete-product-modal__hint" data-i18n="aproduct.delete_hint">Hành động này không thể hoàn tác.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="admin-btn admin-btn--secondary" data-bs-dismiss="modal" data-i18n="common.cancel">Hủy</button>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteProductId" />
                    <button type="submit" class="admin-btn admin-btn--danger" data-i18n="common.delete">Xóa</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const deleteProductModal = document.getElementById('deleteProductModal');
        if (deleteProductModal) {
            $(deleteProductModal).on('show.bs.modal', function (event) {
                const triggerButton = event.relatedTarget;
                const productId = triggerButton?.getAttribute('data-product-id');
                const productName = triggerButton?.getAttribute('data-product-name') || '';

                const idField = deleteProductModal.querySelector('#deleteProductId');
                const nameField = deleteProductModal.querySelector('#deleteProductName');

                if (idField) {
                    idField.value = productId || '';
                }

                if (nameField) {
                    nameField.textContent = productName;
                }
            });
        }
    </script>
}
